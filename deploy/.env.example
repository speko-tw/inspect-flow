# 部署專用範本；複製成 compose.yaml 同目錄的 .env。
# 首次試用由負責人發布 pilot-test，公開 package 後才可拉取。
INSPECTFLOW_IMAGE_TAG=pilot-test
# 主機 8080 對應容器 8000；僅讓同機 Nginx 存取。
INSPECTFLOW_HOST_PORT=8080
INSPECTFLOW_BIND_ADDRESS=127.0.0.1
# 根目錄留空；子路徑填 /inspectflow，不加結尾斜線。
INSPECTFLOW_BASE_PATH=
# Uvicorn 信任的代理來源 IP/CIDR；預設只信任 loopback。
# Docker 轉送通常來自 bridge gateway，請依安裝說明查出並填入。
# 禁止任意來源能直連容器時使用 *。
INSPECTFLOW_FORWARDED_ALLOW_IPS=127.0.0.1
# 預設留空用具名 volume；進階 bind 模式填已建立的絕對路徑。
INSPECTFLOW_DATA_DIR=
INSPECTFLOW_UPLOADS_DIR=
# 登入閒置期限（分鐘）、絕對期限（小時）；必須是正整數。
INSPECTFLOW_SESSION_IDLE_TIMEOUT_MINUTES=60
INSPECTFLOW_SESSION_ABSOLUTE_TIMEOUT_HOURS=8
# 登入失敗門檻、計算期間及鎖定時間（分鐘）。
INSPECTFLOW_LOGIN_FAILURE_THRESHOLD=10
INSPECTFLOW_LOGIN_FAILURE_WINDOW_MINUTES=15
INSPECTFLOW_LOGIN_LOCKOUT_MINUTES=15
# SQLite 寫鎖等待上限（毫秒），範圍 1～60000。
INSPECTFLOW_SQLITE_BUSY_TIMEOUT_MS=5000
# 首次設定失敗門檻、計算期間及鎖定時間（分鐘）。
INSPECTFLOW_SETUP_FAILURE_THRESHOLD=10
INSPECTFLOW_SETUP_FAILURE_WINDOW_MINUTES=15
INSPECTFLOW_SETUP_LOCKOUT_MINUTES=15
