# DPL-R09：公司憑證只放在 Nginx 主機，不掛進 app 容器。
server {
    listen 80;
    server_name inspectflow.example.internal;
    return 301 https://$host$request_uri;
}
server {
    listen 443 ssl;
    server_name inspectflow.example.internal;
    ssl_certificate /etc/nginx/tls/inspectflow-fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/inspectflow-key.pem;
    # 比後端照片單檔 30 MiB 多留 multipart 欄位與標頭空間。
    client_max_body_size 32m;
    # 相對 Location 保留外部連線的非預設 port。
    absolute_redirect off;
    location = /inspectflow { return 308 /inspectflow/; }
    location /inspectflow/ {
        proxy_pass http://127.0.0.1:8080/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # 單層代理覆寫來自用戶端的值，避免偽造來源 IP。
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }
}
