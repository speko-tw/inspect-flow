# DPL-R09：公司憑證只放在 Nginx 主機，不掛進 app 容器。
server {
    listen 80;
    server_name inspectflow.example.internal;
    return 301 https://$host$request_uri;
}
server {
    listen 443 ssl;
    server_name inspectflow.example.internal;
    ssl_certificate /etc/nginx/tls/inspectflow-fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/inspectflow-key.pem;
    # 目前照片 API 尚未完成；先預留 25 MiB，日後依 API 上限調整。
    client_max_body_size 25m;
    location / {
        proxy_pass http://127.0.0.1:8080/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # 單層代理覆寫來自用戶端的值，避免偽造來源 IP。
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }
}
