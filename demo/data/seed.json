  "templates": [
    {
      "title": "排水管坡度檢查",
      "instruction": "確認排水橫管坡度與固定間距符合圖說。",
      "points": [
        {
          "title": "排水橫管坡度",
          "instruction": "沿管線量測坡度，並記錄管線編號。",
          "fields": [
            {
              "name": "管線編號",
              "type": "text"
            },
            {
              "name": "實測坡度",
              "type": "number",
              "unit": "%",
              "standard": {
                "condition": "range",
                "range_form": "interval",
                "lower_bound": "1.0",
                "upper_bound": "2.0"
              }
            }
          ],
          "photos": 1
        },
        {
          "title": "支撐吊架間距",
          "instruction": "量測相鄰兩組吊架的間距。",
          "fields": [
            {
              "name": "吊架間距",
              "type": "number",
              "unit": "m",
              "standard": {
                "condition": "range",
                "range_form": "tolerance",
                "value": "1.5",
                "tolerance": "0.2"
              }
            }
          ],
          "photos": 2
        }
      ]
    },
    {
      "title": "給水管試壓檢查",
      "instruction": "確認給水管完成試壓、保壓且接頭無滲漏。",
      "points": [
        {
          "title": "試壓保壓壓力",
          "instruction": "保壓 30 分鐘後讀取壓力表。",
          "fields": [
            {
              "name": "保壓壓力",
              "type": "number",
              "unit": "MPa",
              "standard": {
                "condition": ">=",
                "value": "1.0"
              }
            }
          ],
          "photos": 1
        },
        {
          "title": "接頭外觀",
          "instruction": "逐一檢視接頭是否滲水或變形。",
          "text_standard": "接頭無滲漏、無變形",
          "photos": 1
        }
      ]
    },
    {
      "title": "止水閥標示檢查",
      "instruction": "確認閥件標示清楚、開關方向正確。",
      "points": [
        {
          "title": "閥件標示與開關方向",
          "instruction": "檢視標示牌與閥件開關方向。",
          "text_standard": "標示清楚、開關方向與標示一致",
          "photos": 1
        }
      ]
    }
  ]
